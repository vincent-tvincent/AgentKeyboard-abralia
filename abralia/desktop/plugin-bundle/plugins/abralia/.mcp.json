{
  "mcpServers": {
    "abralia": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": [
        "./scripts/abralia-launch",
        "mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "TERM_PROGRAM", "TERM_PROGRAM_VERSION", "GHOSTTY_SURFACE_ID", "ITERM_SESSION_ID",
        "WEZTERM_PANE", "WEZTERM_UNIX_SOCKET", "KITTY_WINDOW_ID", "KITTY_LISTEN_ON",
        "VSCODE_IPC_HOOK_CLI", "VSCODE_PID", "WT_SESSION"
      ]
    }
  }
}
