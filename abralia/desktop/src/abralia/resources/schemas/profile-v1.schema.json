{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abralia.dev/schemas/rgb-layout-profile-v1.schema.json",
  "title": "Abralia keyboard profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "adapter",
    "device_match",
    "keymap",
    "expected_led_count",
    "capabilities",
    "elements",
    "regions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "min_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "min_version": {"type": "integer", "minimum": 1}
      }
    },
    "device_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_id", "product_id", "usage_page", "usage"],
      "properties": {
        "vendor_id": {"$ref": "#/$defs/u16"},
        "product_id": {"$ref": "#/$defs/u16"},
        "usage_page": {"$ref": "#/$defs/u16"},
        "usage": {"$ref": "#/$defs/u16"}
      }
    },
    "keymap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_rows", "matrix_columns", "encoder_count"],
      "properties": {
        "matrix_rows": {"type": "integer", "minimum": 1},
        "matrix_columns": {"type": "integer", "minimum": 1},
        "encoder_count": {"type": "integer", "minimum": 0}
      }
    },
    "expected_led_count": {"type": "integer", "minimum": 1},
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toggle_matrix"],
      "properties": {
        "toggle_matrix": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_key_rgb", "independent_brightness", "guarded_frames", "local_animation"],
      "properties": {
        "per_key_rgb": {"type": "boolean"},
        "independent_brightness": {"type": "boolean"},
        "guarded_frames": {"type": "boolean"},
        "local_animation": {"type": "boolean"}
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/element"}
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/region"}
    },
    "semantic_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {"$ref": "#/$defs/element_id"},
          "uniqueItems": true
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/element_id"}
    }
  },
  "$defs": {
    "u16": {"type": "integer", "minimum": 0, "maximum": 65535},
    "element_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_]*$"},
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "row", "order", "geometry", "led_address", "led_point", "matrix"],
      "properties": {
        "id": {"$ref": "#/$defs/element_id"},
        "type": {"enum": ["key", "encoder", "indicator", "lightbar", "zone"]},
        "row": {"type": "integer", "minimum": 0},
        "order": {"type": "integer", "minimum": 0},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "width": {"type": "number", "exclusiveMinimum": 0},
            "height": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "led_address": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "led_point": {
          "oneOf": [
            {"$ref": "#/$defs/point"},
            {"type": "null"}
          ]
        },
        "matrix": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0}
              ],
              "minItems": 2,
              "maxItems": 2
            },
            {"type": "null"}
          ]
        },
        "encoder": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["index", "direction"],
              "properties": {
                "index": {"type": "integer", "minimum": 0},
                "direction": {"enum": ["counterclockwise", "clockwise"]}
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "elements", "strategies"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/element_id"},
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"$ref": "#/$defs/element_id"},
            "uniqueItems": true
          }
        },
        "strategies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["geometry_resample", "row_key_index", "anchored_row_grid"]}
        },
        "large_key_threshold_u": {"type": "number", "exclusiveMinimum": 0},
        "anchored_rows": {
          "type": "array",
          "items": {"$ref": "#/$defs/element_id"},
          "uniqueItems": true
        }
      }
    }
  }
}
