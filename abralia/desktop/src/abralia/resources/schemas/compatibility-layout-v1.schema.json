{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abralia.dev/schemas/compatibility-layout-v1.schema.json",
  "title": "Abralia compatibility layout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "regions"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "alias_imports": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "matrix_aliases": {"$ref": "#/$defs/matrix_aliases"},
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/region"}
    }
  },
  "$defs": {
    "element_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_]*$"},
    "matrix_position": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "matrix_aliases": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/element_id"},
      "additionalProperties": {"$ref": "#/$defs/matrix_position"}
    },
    "matrix_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix"],
      "properties": {"matrix": {"$ref": "#/$defs/matrix_position"}}
    },
    "element_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element"],
      "properties": {"element": {"$ref": "#/$defs/element_id"}}
    },
    "selector": {
      "oneOf": [
        {"$ref": "#/$defs/element_id"},
        {"$ref": "#/$defs/matrix_selector"},
        {"$ref": "#/$defs/element_selector"}
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rows", "strategies"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/selector"}
          }
        },
        "strategies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["geometry_resample", "row_key_index", "anchored_row_grid"]
          }
        },
        "large_key_threshold_u": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
